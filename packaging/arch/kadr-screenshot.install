# kadr-kms reads the framebuffers being scanned out (DRM GETFB2 + PRIME export), which the
# kernel only allows with CAP_SYS_ADMIN. It is a tiny helper that does nothing else; without
# the capability Kadr falls back to wlr-screencopy.
post_install() {
  setcap cap_sys_admin+ep usr/bin/kadr-kms
}

post_upgrade() {
  post_install
}
